  m_Name: SvenSnowdrift
  m_EditorClassIdentifier: Assembly-CSharp::SomeGame.Race.RivalCharacter
  displayName: Sven Snowdrift
  title: THE SHOW-OFF SKI INSTRUCTOR
  bio: Teaches skiing, mostly to his own reflection. Has never once fallen over, he says. Loves his hair, hates losing.
  portrait: {fileID: 21300000, guid: 187cf1aec13e04a4eb1755dfce722da1, type: 3}
