  m_Name: CaptainKipper
  m_EditorClassIdentifier: Assembly-CSharp::SomeGame.Race.RivalCharacter
  displayName: Captain Kipper
  title: THE PIRATE WHO NEVER PAYS
  bio: Says he sailed all seven seas, but only ever left Pirate Bay once, by mistake. Owes everybody money, loves his boat.
  portrait: {fileID: 21300000, guid: 87bdb0ea06b9e4737a26791ec360e174, type: 3}
