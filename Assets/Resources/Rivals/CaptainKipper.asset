  homeRace: {fileID: 11400000, guid: 58a8a882dbacb4ed68d391f42598d17f, type: 2}
  carColor: {r: 0.6039216, g: 0.38431373, b: 0.21176471, a: 1}
  body: speedboat
  top: jollyroger
  decal: skull
  gadget: broadside
  meetLines:
  - surprised|Arrr! Who goes there? A landlubber in MY bay?
  - smug|Captain Kipper, terror of the seven seas! Well... of this bay, mostly.
  - laugh|See these cannons? Come alongside me and BOOM! A broadside, right in your bilge!
  - wink|Beat me round Pirate Bay and the broadside is yours. Fair trade, says I!
  cardLine: Pirate Bay be MY waters. Turn back while ye can!
  startLines:
  - smug|Hoist the sails, ye scallywag!
  - laugh|Stay off my port side... and my starboard side!
  - wink|Last one round buys the rum! Er, lemonade!
  winLines:
  - laugh|Yo ho ho! Back to the shallows with ye!
  - smug|That's how a captain sails!
  - wink|Shiver me timbers, that was easy!
  loseLines:
  - angry|Barnacles! My peg leg slipped!
  - surprised|Blow me down... ye beat the captain?
  - thinking|Hmm. I'll blame the parrot.
